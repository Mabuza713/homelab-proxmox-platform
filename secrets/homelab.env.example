# copy to secrets/homelab.env and fill in, the real file is gitignored.
# token is made in the proxmox ui: datacenter -> permissions -> api tokens.
# ssh to the node is set up in terraform/main.tf, not here.

PROXMOX_VE_ENDPOINT=https://192.168.1.17:8006/
# format: USER@REALM!TOKENID=SECRET
PROXMOX_VE_API_TOKEN=
# self-signed cert on the lan, so skip verification
PROXMOX_VE_INSECURE=true
